# mistlib source: scripts/fetch-mistlib clones it into .mistlib-src/, which the
# Cargo path dependencies point into. Changing MISTLIB_REPO here re-points an
# existing .mistlib-src clone on the next `just fetch-mistlib` -- no need to
# delete it first.
#
# The default is the public repository (no credentials needed). To build against
# the private development repository instead -- e.g. to pick up mistlib changes
# before they are synced/released publicly -- comment out the public pair and
# uncomment the dev one. Use whichever URL form your git auth can clone.
MISTLIB_REPO=https://github.com/tik-choco-lab/mistlib.git
MISTLIB_REF=main
#MISTLIB_REPO=git@github.com:tik-choco-lab/mistlib-dev.git
#MISTLIB_REF=develop

# mistlib-consensus source (public repo): scripts/fetch-mistlib-consensus
# clones it into .mistlib-consensus-src/, which the Cargo path dependencies
# point into. Use whichever URL form your git auth can clone (ssh or https).
MISTLIB_CONSENSUS_REPO=https://github.com/tik-choco-lab/mistlib-consensus.git
MISTLIB_CONSENSUS_REF=main
