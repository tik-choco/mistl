# mistlib source (private repo): scripts/fetch-mistlib clones it into
# .mistlib-src/, which the Cargo path dependencies point into.
# Use whichever URL form your git auth can clone (ssh or https).
MISTLIB_REPO=git@github.com:tik-choco-lab/mistlib-dev.git
MISTLIB_REF=develop

# mistlib-consensus source (private repo): scripts/fetch-mistlib-consensus
# clones it into .mistlib-consensus-src/, which the Cargo path dependencies
# point into. Use whichever URL form your git auth can clone (ssh or https).
MISTLIB_CONSENSUS_REPO=https://github.com/tik-choco-lab/mistlib-consensus.git
MISTLIB_CONSENSUS_REF=main
